// ============================================================
// 5. RESTRIÇÕES ALIMENTARES E DADOS NUTRICIONAIS
//
// Vínculo Ingrediente x RestricaoAlimentar (v4): a TACO não carrega
// classificação de alergênico/restrição — é curadoria humana, sempre.
// Doença crônica com regra numérica (ex: hipertensão via sódio) é a
// única exceção onde o vínculo pode ser gerado automaticamente, e só
// quando o dado nutricional de origem não é nulo (ver
// RestricaoRegraNutricional abaixo e o campo `origem` em
// IngredienteRestricao).
// ============================================================

model RestricaoAlimentar {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome      String        @unique @db.VarChar(255)
  tipo      TipoRestricao
  descricao String?       @db.Text
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  pacientes              PacienteRestricao[]
  ingredientes           IngredienteRestricao[]
  campanhasPublicitarias CampanhaPublicitaria[]
  regrasNutricionais     RestricaoRegraNutricional[]
  ingredienteSubstitutos IngredienteSubstituto[]
  receitaAdaptacoes      ReceitaAdaptacao[]
  // v5: público-alvo no marketplace (filtro de receitas à venda e de produtos).
  ofertasPublicoAlvo     ReceitaOfertaPublicoAlvo[]
  produtosPublicoAlvo    ProdutoPublicoAlvo[]

  @@map("restricoes_alimentares")
}

model PacienteRestricao {
  pacienteId  String    @map("paciente_id") @db.Uuid
  restricaoId String    @map("restricao_id") @db.Uuid
  gravidade   Gravidade @default(moderada)
  observacao  String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  paciente  Paciente           @relation(fields: [pacienteId], references: [id])
  restricao RestricaoAlimentar @relation(fields: [restricaoId], references: [id])

  @@id([pacienteId, restricaoId])
  @@map("paciente_restricoes")
}

model Ingrediente {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                  String    @db.VarChar(255)
  fonteDados            String?   @map("fonte_dados") @db.VarChar(100)
  codigoFonteExterno    String?   @unique @map("codigo_fonte_externo") @db.VarChar(50)
  caloriasKcal          Decimal?  @map("calorias_kcal") @db.Decimal(8, 2)
  proteinasG            Decimal?  @map("proteinas_g") @db.Decimal(8, 2)
  carboidratosG         Decimal?  @map("carboidratos_g") @db.Decimal(8, 2)
  gordurasG             Decimal?  @map("gorduras_g") @db.Decimal(8, 2)
  fibrasG               Decimal?  @map("fibras_g") @db.Decimal(8, 2)
  sodioMg               Decimal?  @map("sodio_mg") @db.Decimal(8, 2)
  // Quando um curador revisou as restrições do ingrediente. Sem vínculo em
  // IngredienteRestricao só significa "seguro" depois dessa revisão: um
  // ingrediente novo (criado por usuário ou pela IA) nasce sem vínculo e
  // não pode passar como seguro para alergia.
  restricoesRevisadasEm DateTime? @map("restricoes_revisadas_em") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  restricoes           IngredienteRestricao[]
  receitas             ReceitaIngrediente[]
  substituicoesOrigem  IngredienteSubstituto[] @relation("SubOrigem")
  substituicoesDestino IngredienteSubstituto[] @relation("SubDestino")

  @@index([nome])
  @@map("ingredientes")
}

model IngredienteRestricao {
  ingredienteId String                 @map("ingrediente_id") @db.Uuid
  restricaoId   String                 @map("restricao_id") @db.Uuid
  // v4: distingue vínculo curado manualmente de vínculo gerado por
  // RestricaoRegraNutricional. Sem isso, recomputar uma regra (ex:
  // ajustar o limiar de sódio) poderia sobrescrever uma decisão manual
  // de curador sem ninguém perceber. Default `manual` porque todo
  // vínculo pré-v4 e todo vínculo criado via API (POST individual) é
  // curadoria humana; só o script de bootstrap grava os outros dois
  // valores explicitamente.
  origem        OrigemVinculoRestricao @default(manual)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  ingrediente Ingrediente        @relation(fields: [ingredienteId], references: [id])
  restricao   RestricaoAlimentar @relation(fields: [restricaoId], references: [id])

  @@id([ingredienteId, restricaoId])
  @@map("ingrediente_restricoes")
}

// v4: limiar numérico de doença crônica, ligado à restrição — não ao
// ingrediente nem ao vínculo. Uma linha por regra (ex: hipertensão x
// sódio). Ajustar o limiar é um UPDATE aqui, não uma reescrita de
// centenas de linhas de IngredienteRestricao.
//
// campoNutricional referencia um campo de Ingrediente pelo nome
// (ex: "sodioMg") ou uma expressão derivada conhecida pela aplicação
// (ex: "carboidratoLiquido" = carboidratosG - fibrasG, usado por
// diabetes). Validação de que o campo existe é responsabilidade da
// aplicação, não do banco — mesmo padrão de trade-off já aceito nas
// lookup tables (UnidadeMedida/TipoNotificacao) mais abaixo.
//
// valorLimite pode ficar null: a linha existe (a restrição já está
// marcada como "tem regra baseada em nutriente"), mas o número em si
// aguarda validação clínica/nutricionista antes de ativar a
// automação. Nenhum job deve gerar vínculo automático a partir de
// uma regra com valorLimite null.
model RestricaoRegraNutricional {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restricaoId      String                   @map("restricao_id") @db.Uuid
  campoNutricional CampoNutricionalRegra    @map("campo_nutricional")
  operador         OperadorRegraNutricional
  valorLimite      Decimal?                 @map("valor_limite") @db.Decimal(8, 2)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  restricao RestricaoAlimentar @relation(fields: [restricaoId], references: [id])

  @@index([restricaoId])
  @@map("restricao_regras_nutricionais")
}

model IngredienteSubstituto {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ingredienteOrigemId  String   @map("ingrediente_origem_id") @db.Uuid
  restricaoId          String   @map("restricao_id") @db.Uuid
  ingredienteDestinoId String   @map("ingrediente_destino_id") @db.Uuid
  prioridade           Int      @default(0)
  observacao           String?  @db.Text
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  restricao          RestricaoAlimentar @relation(fields: [restricaoId], references: [id])
  ingredienteOrigem  Ingrediente        @relation("SubOrigem", fields: [ingredienteOrigemId], references: [id])
  ingredienteDestino Ingrediente        @relation("SubDestino", fields: [ingredienteDestinoId], references: [id])

  @@unique([ingredienteOrigemId, restricaoId, ingredienteDestinoId])
  @@index([ingredienteOrigemId, restricaoId])
  @@map("ingrediente_substitutos")
}

// ============================================================
// LOOKUP TABLES (Refatoração 3 — domínios dinâmicos)
//
// UnidadeMedida e TipoNotificacao deixaram de ser enum nativo do
// Postgres. Motivo: adicionar um valor a um enum do Postgres via
// Prisma exige `ALTER TYPE ... ADD VALUE` numa nova migration + deploy
// — inviável para listas que crescem por decisão operacional (ex: a
// equipe de curadoria quer cadastrar "colher de chá rasa" ou um novo
// tipo de notificação de produto sem esperar um deploy de backend).
//
// Trade-off: perdemos a validação de tipo em tempo de compilação que
// o enum dava; ganhamos flexibilidade de cadastro via INSERT simples.
// A validação de "código é válido" passa a ser responsabilidade de a
// aplicação consultar a tabela (ou cachear os códigos ativos).
//
// v5: CategoriaProduto entra aqui pelo mesmo motivo — a lista de
// categorias da vitrine cresce por decisão operacional.
// ============================================================

model UnidadeMedida {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo String  @unique @db.VarChar(20) // g, kg, ml, l, unidade, colher_sopa...
  nome   String  @db.VarChar(50)
  ativo  Boolean @default(true)

  receitaIngredientes ReceitaIngrediente[]

  @@map("unidades_medida")
}

model TipoNotificacao {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo    String  @unique @db.VarChar(50) // aprovacao_receita, checklist_pendente...
  nome      String  @db.VarChar(100)
  descricao String? @db.Text
  ativo     Boolean @default(true)

  notificacoes Notificacao[]

  @@map("tipos_notificacao")
}

model CategoriaProduto {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo String  @unique @db.VarChar(50) // alimentos, suplementos, utensilios, livros...
  nome   String  @db.VarChar(100)
  ativo  Boolean @default(true)

  produtos Produto[]

  @@map("categorias_produto")
}

// ============================================================
// 6. RECEITAS, CURADORIA E VERSIONAMENTO
// ============================================================

model Receita {
  id                       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                     String           @db.VarChar(255)
  descricao                String?          @db.Text
  modoPreparo              String?          @map("modo_preparo") @db.Text
  tempoPreparoMin          Int?             @map("tempo_preparo_min")
  porcoes                  Int?
  nivelDificuldade         NivelDificuldade @default(medio) @map("nivel_dificuldade")
  avisoContaminacaoCruzada Boolean          @default(false) @map("aviso_contaminacao_cruzada")
  // Citados no modo de preparo e ausentes da lista (apontados pela IA). Não
  // vazio = para restrição estrita, a receita conta como não revisada.
  ingredientesNaoListados  String[]         @default([]) @map("ingredientes_nao_listados")
  criadoPor                String           @map("criado_por") @db.Uuid
  status                   StatusReceita    @default(pendente)
  profissionalAprovadorId  String?          @map("profissional_aprovador_id") @db.Uuid
  dataAprovacao            DateTime?        @map("data_aprovacao") @db.Timestamptz(6)
  versaoAtual              Int              @default(1) @map("versao_atual")
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime?        @map("deleted_at") @db.Timestamptz(6)

  criador               Usuario              @relation("ReceitaCriadoPor", fields: [criadoPor], references: [id])
  profissionalAprovador Profissional?        @relation("ReceitaAprovador", fields: [profissionalAprovadorId], references: [id])
  versoes               ReceitaVersao[]
  midias                ReceitaMidia[]
  ingredientes          ReceitaIngrediente[]
  pontosTransacoes      PontosTransacao[]
  favoritos             Favorito[]
  planoAlimentarItens   PlanoAlimentarItem[]
  notificacoes          Notificacao[]
  // Adaptações feitas a partir desta receita.
  adaptacoes            ReceitaAdaptacao[]   @relation("AdaptacaoOrigem")
  // Preenchido quando esta receita é a versão adaptada de outra.
  adaptacaoDe           ReceitaAdaptacao?    @relation("AdaptacaoAdaptada")
  // v5: preenchido quando esta receita tem oferta (está, ou esteve, à
  // venda). Com oferta, o conteúdo completo sai das rotas públicas.
  oferta                ReceitaOferta?
  // v5: preenchido quando esta receita é a cópia entregue numa compra.
  // Cópia é privada do comprador, imutável e nunca pode ter oferta.
  copiaDeCompra         ReceitaCompra?       @relation("CompraCopia")

  @@index([status])
  @@index([criadoPor])
  @@map("receitas")
}

// Liga uma receita à versão adaptada dela (regra_negocio_receitas_seguras.md).
// A adaptada é uma Receita comum: a verificação é a aprovação dela.
// Dois tipos:
// - para uma restrição (restricaoId, sem pacienteId): automática, pública e
//   reaproveitada por quem tem a mesma restrição;
// - para um paciente (pacienteId, sem restricaoId): escolhida pelo
//   profissional dele, já verificada e visível só para esse paciente.
//
// v5: quando a origem é uma receita à venda ou uma cópia comprada, a
// adaptação herda a visibilidade da origem — nunca é pública nem
// reaproveitada por terceiros, senão o conteúdo pago vazaria pelo
// catálogo. Não muda a modelagem: a regra é da camada de visibilidade.
model ReceitaAdaptacao {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receitaOrigemId   String   @map("receita_origem_id") @db.Uuid
  // versaoAtual da origem na hora da adaptação: origem editada depois
  // deixa a adaptação desatualizada.
  versaoOrigem      Int      @map("versao_origem")
  receitaAdaptadaId String   @unique @map("receita_adaptada_id") @db.Uuid
  restricaoId       String?  @map("restricao_id") @db.Uuid
  pacienteId        String?  @map("paciente_id") @db.Uuid
  // Para o profissional que verifica: o que mudou e o que conferir.
  resumoIa          String?  @map("resumo_ia") @db.Text
  // [{ ingredienteOrigemId, acao: "substituir" | "remover", ingredienteDestinoId? }]
  // Na aprovação, as substituições viram IngredienteSubstituto.
  trocas            Json
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  receitaOrigem   Receita             @relation("AdaptacaoOrigem", fields: [receitaOrigemId], references: [id])
  receitaAdaptada Receita             @relation("AdaptacaoAdaptada", fields: [receitaAdaptadaId], references: [id])
  restricao       RestricaoAlimentar? @relation(fields: [restricaoId], references: [id], onDelete: Restrict)
  paciente        Paciente?           @relation(fields: [pacienteId], references: [id], onDelete: Restrict)

  @@unique([receitaOrigemId, restricaoId])
  @@index([pacienteId])
  @@map("receita_adaptacoes")
}

model ReceitaVersao {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receitaId       String   @map("receita_id") @db.Uuid
  versao          Int
  nome            String   @db.VarChar(255)
  descricao       String?  @db.Text
  modoPreparo     String?  @map("modo_preparo") @db.Text
  alteradoPor     String   @map("alterado_por") @db.Uuid
  motivoAlteracao String?  @map("motivo_alteracao") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  receita        Receita @relation(fields: [receitaId], references: [id])
  autorAlteracao Usuario @relation("ReceitaVersaoAlteradoPor", fields: [alteradoPor], references: [id])

  // Refatoração 5: @@unique já cria índice em (receitaId, versao), mas
  // uma consulta que filtra só por receitaId (ex: "listar histórico
  // completo dessa receita") não usa esse índice composto de forma
  // eficiente sem o versaoo estar no predicado. Um índice dedicado em
  // receitaId sozinho serve exatamente essa consulta mais comum.
  @@unique([receitaId, versao])
  @@index([receitaId])
  @@map("receita_versoes")
}

model ReceitaMidia {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receitaId String    @map("receita_id") @db.Uuid
  url       String    @db.VarChar(500)
  tipo      TipoMidia @default(capa)
  ordem     Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  receita Receita @relation(fields: [receitaId], references: [id])

  @@index([receitaId])
  @@map("receita_midias")
}

model ReceitaIngrediente {
  receitaId       String  @map("receita_id") @db.Uuid
  ingredienteId   String  @map("ingrediente_id") @db.Uuid
  quantidade      Decimal @db.Decimal(8, 2)
  unidadeMedidaId String  @map("unidade_medida_id") @db.Uuid

  receita       Receita       @relation(fields: [receitaId], references: [id])
  ingrediente   Ingrediente   @relation(fields: [ingredienteId], references: [id])
  unidadeMedida UnidadeMedida @relation(fields: [unidadeMedidaId], references: [id])

  @@id([receitaId, ingredienteId])
  @@map("receita_ingredientes")
}

model PontosTransacao {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profissionalId String              @map("profissional_id") @db.Uuid
  receitaId      String?             @map("receita_id") @db.Uuid
  pontos         Int
  tipo           TipoTransacaoPontos
  descricao      String?             @db.VarChar(500)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  profissional Profissional @relation(fields: [profissionalId], references: [id])
  receita      Receita?     @relation(fields: [receitaId], references: [id])

  @@index([profissionalId])
  @@map("pontos_transacoes")
}

model Favorito {
  usuarioId String   @map("usuario_id") @db.Uuid
  receitaId String   @map("receita_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  receita Receita @relation(fields: [receitaId], references: [id])

  @@id([usuarioId, receitaId])
  @@map("favoritos")
}

// ============================================================
// 7. PLANO ALIMENTAR (tabela semanal estilo Mfit)
// ============================================================

model PlanoAlimentar {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pacienteId     String    @map("paciente_id") @db.Uuid
  profissionalId String    @map("profissional_id") @db.Uuid
  nome           String    @db.VarChar(255)
  dataInicio     DateTime  @map("data_inicio") @db.Date
  dataFim        DateTime? @map("data_fim") @db.Date
  ativo          Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  paciente     Paciente             @relation(fields: [pacienteId], references: [id])
  profissional Profissional         @relation(fields: [profissionalId], references: [id])
  itens        PlanoAlimentarItem[]

  @@index([pacienteId])
  @@map("planos_alimentares")
}

// v5: receitaId pode apontar para a cópia de uma receita comprada, desde
// que a cópia seja do paciente do plano (validado na aplicação). Uma
// receita à venda que o paciente não comprou não entra no plano.
model PlanoAlimentarItem {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planoAlimentarId String       @map("plano_alimentar_id") @db.Uuid
  receitaId        String       @map("receita_id") @db.Uuid
  diaSemana        DiaSemana    @map("dia_semana")
  tipoRefeicao     TipoRefeicao @map("tipo_refeicao")
