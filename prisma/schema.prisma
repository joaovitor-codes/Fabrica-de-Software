// v5 (Exclusive Arc): um pagamento é de uma Assinatura OU de uma
// ReceitaCompra, nunca dos dois. assinaturaId deixou de ser obrigatório
// (migration sem perda: toda linha existente já tem assinaturaId). A
// CHECK chk_pagamento_exclusive_arc do cabeçalho garante o "exatamente
// um".
//
// Uma ReceitaCompra pode ter mais de um Pagamento (tentativa que falhou
// e outra que passou); por isso a relação é N:1 e não 1:1.
//
// Na compra de receita o Pagamento nasce no webhook, não na criação da
// compra: com o Checkout Pro, o ID do pagamento só existe depois que o
// comprador paga. Até lá a compra tem só a preferência
// (ReceitaCompra.gatewayPreferenciaId).
model Pagamento {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assinaturaId      String?         @map("assinatura_id") @db.Uuid
  receitaCompraId   String?         @map("receita_compra_id") @db.Uuid
  valor             Decimal         @db.Decimal(10, 2)
  statusPagamento   StatusPagamento @default(pendente) @map("status_pagamento")
  metodoPagamento   String?         @map("metodo_pagamento") @db.VarChar(100)
  // v5: ID do pagamento no gateway (no Mercado Pago, o `data.id` da
  // notificação). @unique para o webhook ser idempotente:
  // o gateway reenvia o mesmo evento, e a segunda entrega acha a linha já
  // processada em vez de liberar a cópia duas vezes.
  gatewayCobrancaId String?         @unique @map("gateway_cobranca_id") @db.VarChar(255)
  dataPagamento     DateTime?       @map("data_pagamento") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  assinatura    Assinatura?    @relation(fields: [assinaturaId], references: [id])
  receitaCompra ReceitaCompra? @relation(fields: [receitaCompraId], references: [id])

  @@index([assinaturaId])
  @@index([receitaCompraId])
  @@map("pagamentos")
}

