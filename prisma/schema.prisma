// ============================================================
// NUTRIFY - schema.prisma (v5 - marketplace: venda de receitas e
// vitrine de produtos)
//
// Este arquivo aplica, sobre a v4, as decisões da discussão sobre
// o marketplace (seção "Marketplace" da documentação da API):
//
//   1. Venda de receitas: ReceitaOferta (preço e público-alvo de uma
//      Receita), ReceitaCompra (a compra e a cópia entregue) e
//      ContaRecebedor (cadastro do vendedor no gateway, para o split).
//      A cópia entregue ao comprador é uma Receita comum, privada —
//      mesmo padrão de ReceitaAdaptacao ("a adaptada é uma Receita
//      comum"). Por isso restricoesVioladas, adaptação e plano
//      alimentar funcionam sobre ela sem modelagem nova.
//   2. Pagamento deixa de ser exclusivo de Assinatura: assinaturaId
//      vira opcional e entra receitaCompraId (exclusive arc, igual a
//      Notificacao). Ganha gatewayCobrancaId para o webhook ser
//      idempotente.
//   3. Vitrine de produtos: Produto, ProdutoMidia, ProdutoPublicoAlvo,
//      ProdutoDenuncia e a lookup table CategoriaProduto. Sem
//      pagamento, carrinho ou frete: a plataforma só intermedia o
//      contato. O nome "Produto" (e não "Anuncio") é de propósito,
//      para não confundir com Anunciante/CampanhaPublicitaria.
//   4. Gateway: Mercado Pago, split 1:1. O vendedor conecta a conta
//      Mercado Pago dele por OAuth; ContaRecebedor guarda os tokens
//      (cifrados). A cobrança é uma preferência do Checkout Pro criada
//      com o token do vendedor e a comissão em `marketplace_fee`.
//   5. Reembolso: o comprador pede em até 7 dias. Se a cópia nunca foi
//      aberta (ReceitaCompra.primeiroAcessoEm nulo), o estorno é
//      automático; se já foi, o pedido vai para análise do admin
//      (status `reembolso_em_analise`).
//   6. Notificacao ganha produtoId no exclusive arc, para avisar o
//      vendedor quando a moderação remove um produto.
//   7. TipoConsentimento ganha `termos_marketplace`: comprar, vender e
//      anunciar exigem o aceite da versão atual dos termos.
//   8. Fora do schema, por decisão explícita: dados bancários do
//      vendedor (ficam só no Mercado Pago), percentual de comissão e
//      preço mínimo (variáveis de ambiente; o valor cobrado fica
//      congelado em ReceitaCompra.taxaPlataforma), chat interno (o
//      contato do produto é por telefone/WhatsApp) e a regra "o
//      profissional não anuncia produto" (validada na aplicação pelo
//      tipoUsuario do vendedor).
//
// SQL raw a adicionar na migration da v5 (o Prisma não expressa):
//
//   ALTER TABLE pagamentos ADD CONSTRAINT chk_pagamento_exclusive_arc
//     CHECK (num_nonnulls(assinatura_id, receita_compra_id) = 1);
//
//   -- No máximo uma compra "viva" por comprador e oferta. Compras
//   -- canceladas ou reembolsadas ficam como histórico e não impedem
//   -- uma nova tentativa.
//   CREATE UNIQUE INDEX uq_receita_compra_viva
//     ON receita_compras (oferta_id, comprador_id)
//     WHERE status IN ('pendente', 'paga', 'reembolso_em_analise');
//
//   -- Notificacao: o arco passa a ter 6 colunas (entra produto_id).
//   ALTER TABLE notificacoes DROP CONSTRAINT chk_notificacao_exclusive_arc;
//   ALTER TABLE notificacoes ADD CONSTRAINT chk_notificacao_exclusive_arc
//     CHECK (
//       num_nonnulls(receita_id, assinatura_id, plano_alimentar_item_id,
//                     indicacao_id, anamnese_id, produto_id) = 1
//     );
//
// Tudo mais abaixo é idêntico à v4.
//
// ------------------------------------------------------------
// Histórico: v4 - vínculo ingrediente x restrição
//
// A v4 aplicou, sobre a v3, as decisões da discussão sobre
// curadoria de vínculo Ingrediente x RestricaoAlimentar:
//
//   1. IngredienteRestricao ganha o campo `origem`, pra distinguir
//      vínculo curado manualmente de vínculo gerado por regra
//      nutricional automática. Sem isso, uma recomputação de regra
//      (ex: ajuste no limiar de sódio da hipertensão) poderia
//      sobrescrever silenciosamente uma decisão manual de curador.
//   2. Nova tabela RestricaoRegraNutricional: guarda o limiar
//      numérico de doenças crônicas cujo vínculo é derivável de campo
//      nutricional já existente em Ingrediente (ex: hipertensão via
//      sodioMg). Fica ligada à RestricaoAlimentar, não ao Ingrediente
//      nem ao IngredienteRestricao — o limiar é uma propriedade da
//      restrição em si, não de cada vínculo individual, então não
//      duplica por ingrediente e pode ser ajustado num lugar só.
//   3. Fora do schema, por decisão explícita: sem tabela de staging
//      de candidatos e sem tabela de dicionário de palavras-chave.
//      A importação da TACO e a geração inicial de vínculos por
//      palavra-chave/regra nutricional rodam como script único
//      (bootstrap), não como feature em produção. O único endpoint
//      de manutenção necessário é o CRUD individual já previsto
//      (POST/GET/DELETE em /api/ingrediente/:id/restricoes).
//
// Decisões de conteúdo (não de schema) tomadas na mesma discussão,
// registradas aqui só como referência, sem afetar a modelagem:
//   - Fonte da TACO: PDF oficial NEPA/UNICAMP, 4ª edição (2011),
//     ~597 alimentos, espelhado pelo CFN.
//   - Tratamento de valores especiais da TACO na importação:
//     "NA" e "*" (não analisado/não disponível) -> null;
//     "Tr" (traço) -> 0. Regra de limiar nunca trata sódio/carboidrato
//     null como "abaixo do limiar" — cai em revisão humana.
//   - Limiar de sódio (hipertensão): 600mg/100g, RDC 429/2020 ANVISA.
//   - Limiar de carboidrato (diabetes): em aberto, depende de
//     validação clínica/nutricionista — RestricaoRegraNutricional já
//     suporta a linha, só falta preencher valorLimite quando decidido.
//   - Doenças renais/gota: fora de escopo por enquanto, faltam campos
//     nutricionais (potássio, fósforo, purinas) em Ingrediente.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
//
// Refatoração 3 (Lookup Tables): removemos os enums UnidadeMedida e
// TipoNotificacao daqui — viraram tabelas de domínio (ver seção
// "LOOKUP TABLES" mais abaixo), porque são listas que crescem sem
// mudança de regra de negócio (ex: adicionar "colher de sobremesa" ou
// um novo tipo de notificação não deveria exigir migration + deploy).
//
// Os enums abaixo permanecem como enum nativo porque representam
// domínios estritamente imutáveis: mudar um desses valores é, na
// prática, mudar uma regra de negócio ou um fluxo de estados que já
// exige alteração de código de qualquer forma (ex: um novo
// status_receita exige nova lógica de aprovação, não é só um cadastro).
// ============================================================

enum TipoUsuario {
  profissional
  paciente
  comum
  admin

  @@map("tipo_usuario_enum")
}

enum StatusAprovacao {
  pendente
  aprovado
  rejeitado

  @@map("status_aprovacao_enum")
}

enum TipoRestricao {
  alergia
  intolerancia
  doenca_cronica
  preferencia

  @@map("tipo_restricao_enum")
}

enum Gravidade {
  leve
  moderada
  grave

  @@map("gravidade_enum")
}

// Origem do vínculo Ingrediente x RestricaoAlimentar. Necessário pra
// automação de doença crônica (via RestricaoRegraNutricional) nunca
// sobrescrever silenciosamente uma decisão de curadoria manual.
enum OrigemVinculoRestricao {
  manual
  automatico_regra_nutricional
  automatico_confirmado_curadoria

  @@map("origem_vinculo_restricao_enum")
}

// Campo nutricional de Ingrediente sobre o qual uma RestricaoRegraNutricional
// pode operar. Fechado (não é domínio dinâmico) porque cada valor só faz
// sentido se existir a coluna Decimal correspondente em Ingrediente — um
// valor novo aqui sempre exige migration de qualquer forma.
enum CampoNutricionalRegra {
  calorias_kcal
  proteinas_g
  carboidratos_g
  gorduras_g
  fibras_g
  sodio_mg

  @@map("campo_nutricional_regra_enum")
}

enum OperadorRegraNutricional {
  maior_que
  maior_igual
  menor_que
  menor_igual

  @@map("operador_regra_nutricional_enum")
}

enum NivelDificuldade {
  facil
  medio
  dificil

  @@map("nivel_dificuldade_enum")
}

enum StatusReceita {
  pendente
  aprovada
  rejeitada

  @@map("status_receita_enum")
}

enum TipoTransacaoPontos {
  ganho_aprovacao
  ganho_rejeicao
  resgate_desconto
  ajuste_manual

  @@map("tipo_transacao_pontos_enum")
}

enum Periodicidade {
  mensal
  anual

  @@map("periodicidade_enum")
}

enum StatusAssinatura {
  trial
  ativa
  cancelada
  expirada

  @@map("status_assinatura_enum")
}

enum StatusPagamento {
  pendente
  pago
  falhou
  reembolsado

  @@map("status_pagamento_enum")
}

enum DiaSemana {
  segunda
  terca
  quarta
  quinta
  sexta
  sabado
  domingo

  @@map("dia_semana_enum")
}

enum TipoRefeicao {
  cafe_da_manha
  lanche_manha
  almoco
  lanche_tarde
  jantar
  ceia

  @@map("tipo_refeicao_enum")
}

enum TipoResposta {
  texto
  numero
  escolha_unica
  escolha_multipla
  booleano

  @@map("tipo_resposta_enum")
}

enum PorteClinica {
  pequeno
  medio
  grande

  @@map("porte_clinica_enum")
}

enum StatusIndicacao {
  pendente
  convertida
  expirada

  @@map("status_indicacao_enum")
}

enum TipoMidia {
  capa
  passo_a_passo
  video

  @@map("tipo_midia_enum")
}

enum TipoConsentimento {
  termos_uso
  dados_saude
  marketing
  // v5: termos do marketplace. Exigido (na versão atual do documento)
  // antes da primeira compra, venda ou anúncio.
  termos_marketplace

  @@map("tipo_consentimento_enum")
}

enum AcaoLog {
  visualizacao
  edicao
  exportacao

  @@map("acao_log_enum")
}

// Tipo de contato para Telefone (refatoração 2). Domínio pequeno e
// estável — permanece enum, diferente de UnidadeMedida/TipoNotificacao.
enum TipoContato {
  celular
  fixo
  whatsapp

  @@map("tipo_contato_enum")
}

// v5 (venda de receitas). Fluxo de estados da compra: cada valor tem
// lógica própria (paga libera a cópia, reembolsada revoga o acesso),
// por isso enum nativo.
//   pendente             -> preferência criada no gateway, aguardando
//                           pagamento
//   paga                 -> webhook confirmou; a cópia existe
//                           (receitaCopiaId)
//   cancelada            -> pagamento falhou ou expirou; nunca houve cópia
//   reembolso_em_analise -> o comprador pediu reembolso de uma cópia já
//                           aberta (ou que o gateway não conseguiu
//                           estornar sozinho); o admin decide. O acesso
//                           à cópia continua até a decisão. Negado,
//                           volta para `paga`.
//   reembolsada          -> dinheiro devolvido; a cópia sai do ar
//                           (deletedAt)
enum StatusCompraReceita {
  pendente
  paga
  cancelada
  reembolso_em_analise
  reembolsada

  @@map("status_compra_receita_enum")
}

// v5 (venda de receitas). Situação da conexão do vendedor com o
// Mercado Pago. Só vendedor `ativo` pode ter oferta à venda. A linha de
// ContaRecebedor só nasce quando o OAuth termina, por isso não existe
// "pendente".
//   ativo        -> conta conectada, token válido
//   desconectado -> o vendedor desconectou, revogou a autorização no
//                   Mercado Pago, ou a renovação do token falhou
enum StatusRecebedor {
  ativo
  desconectado

  @@map("status_recebedor_enum")
}

// v5 (vitrine). `vendido` e `pausado` são do vendedor; `removido` é da
// moderação (admin) e o vendedor não consegue reverter.
enum StatusProduto {
  ativo
  pausado
  vendido
  removido

  @@map("status_produto_enum")
}

// v5 (vitrine). Denúncia procedente remove o produto.
enum StatusDenuncia {
  aberta
  procedente
  improcedente

  @@map("status_denuncia_enum")
}

// ============================================================
// 1. AUTENTICAÇÃO (Conta) x IDENTIDADE/NEGÓCIO (Usuario)
//
// Refatoração 1 (Separation of Concerns):
// A tabela Usuario antiga misturava credenciais de acesso (email,
// senhaHash) com dados de perfil e todas as relações de negócio
// (receitas criadas, favoritos, pontos, notificações...). Isso significa
// que qualquer mudança em política de autenticação (ex: trocar de
// senha+email para OAuth, adicionar 2FA) tocaria a mesma tabela que
// concentra dezenas de relações de domínio — alto acoplamento.
//
// Agora:
// - Conta cuida SÓ de acesso: email, senha, verificação, sessões,
//   tokens, tentativas de login.
// - Usuario cuida de identidade e é o ponto de relação com o resto do
//   domínio (profissional, paciente, receitas, notificações etc.).
// - Relação 1:1 entre elas via contaId.
//
// Isso também abre caminho pra, no futuro, uma Conta ter múltiplos
// métodos de login (ex: tabela ContaProvedorOAuth) sem tocar em Usuario.
// ============================================================

model Conta {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String    @unique @db.VarChar(255)
  senhaHash         String    @map("senha_hash") @db.VarChar(255)
  emailVerificado   Boolean   @default(false) @map("email_verificado")
  emailVerificadoEm DateTime? @map("email_verificado_em") @db.Timestamptz(6)
  ativo             Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  usuario                Usuario?                @relation("ContaUsuario")
  tokensVerificacaoEmail TokenVerificacaoEmail[]
  tokensResetSenha       TokenResetSenha[]
  sessoes                Sessao[]
  tentativasLogin        TentativaLogin[]

  // Nenhum @@index([email]) aqui de propósito: @unique acima já cria
  // um índice único, que serve tanto pra unicidade quanto pra busca.
  // Um @@index([email]) adicional seria um segundo índice idêntico
  // no mesmo campo — custo de escrita em dobro sem ganho de leitura.
  @@map("contas")
}

model Usuario {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contaId        String      @unique @map("conta_id") @db.Uuid
  nome           String      @db.VarChar(255)
  tipoUsuario    TipoUsuario @map("tipo_usuario")
  dataNascimento DateTime?   @map("data_nascimento") @db.Date
  fotoPerfilUrl  String?     @map("foto_perfil_url") @db.VarChar(500)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(6)

  conta Conta @relation("ContaUsuario", fields: [contaId], references: [id])

  // Refatoração 2: telefone/endereco deixam de ser colunas simples
  telefones Telefone[]
  enderecos Endereco[]

  profissional            Profissional?           @relation("UsuarioProfissional")
  paciente                Paciente?               @relation("UsuarioPaciente")
  profissionaisAprovados  Profissional[]          @relation("ProfissionalAprovadoPor")
  receitasCriadas         Receita[]               @relation("ReceitaCriadoPor")
  receitaVersoesAlteradas ReceitaVersao[]         @relation("ReceitaVersaoAlteradoPor")
  comentariosRefeicao     ComentarioRefeicao[]    @relation("ComentarioAutor")
  favoritos               Favorito[]
  notificacoes            Notificacao[]
  consentimentosLgpd      ConsentimentoLgpd[]
  logsAcessoRealizados    LogAcessoDadoSensivel[] @relation("LogAcessoUsuarioAcessante")
  indicacoesFeitas        Indicacao[]             @relation("IndicacaoIndicador")
  indicacoesRecebidas     Indicacao[]             @relation("IndicacaoIndicado")

  // v5: marketplace. Comprar e vender é do Usuario (qualquer tipo), não
  // de Paciente/Profissional.
  contaRecebedor      ContaRecebedor?
  receitasCompradas   ReceitaCompra[]
  produtos            Produto[]
  denunciasFeitas     ProdutoDenuncia[] @relation("DenunciaDenunciante")
  denunciasResolvidas ProdutoDenuncia[] @relation("DenunciaResolvidaPor")

  // NOTA (consistência polimórfica, ver documentação): nada aqui impede
  // um Usuario tipoUsuario = "comum" de também ter linha em Profissional.
  // Precisa de trigger SQL manual na migration, igual no modelo anterior.

  @@index([tipoUsuario])
  @@map("usuarios")
}

// ============================================================
// 2. NORMALIZAÇÃO DE CONTATO E LOCALIZAÇÃO
//
// Refatoração 2: telefone/endereco eram String? soltas em Usuario e
// Clinica. Isso impedia múltiplos números (ex: celular + WhatsApp
// comercial da clínica) e buscas estruturadas (ex: nutricionistas por
// CEP/cidade para achar "profissionais perto de mim").
//
// Telefone e Endereco relacionam com Usuario OU Clinica (nunca os
// dois ao mesmo tempo) via duas FKs opcionais — o mesmo padrão de
// "exclusive arc" usado em Notificacao mais abaixo. Recomendação:
// adicionar via SQL raw na migration:
//
//   ALTER TABLE telefones ADD CONSTRAINT chk_telefone_dono
//     CHECK (num_nonnulls(usuario_id, clinica_id) = 1);
//   ALTER TABLE enderecos ADD CONSTRAINT chk_endereco_dono
//     CHECK (num_nonnulls(usuario_id, clinica_id) = 1);
// ============================================================

model Telefone {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ddi       String?     @db.VarChar(5)
  numero    String      @db.VarChar(20)
  tipo      TipoContato @default(celular)
  principal Boolean     @default(false)
  usuarioId String?     @map("usuario_id") @db.Uuid
  clinicaId String?     @map("clinica_id") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  // onDelete: Cascade: um telefone sem dono não tem razão de existir.
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  clinica Clinica? @relation(fields: [clinicaId], references: [id], onDelete: Cascade)

  // v5: produtos da vitrine que usam este número como contato.
  produtos Produto[]

  @@index([usuarioId])
  @@index([clinicaId])
  @@map("telefones")
}

model Endereco {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cep         String?  @db.VarChar(9)
  logradouro  String?  @db.VarChar(255)
  numero      String?  @db.VarChar(20)
  complemento String?  @db.VarChar(100)
  bairro      String?  @db.VarChar(100)
  cidade      String?  @db.VarChar(100)
  estado      String?  @db.VarChar(2)
  pais        String   @default("Brasil") @db.VarChar(100)
  principal   Boolean  @default(false)
  usuarioId   String?  @map("usuario_id") @db.Uuid
  clinicaId   String?  @map("clinica_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // onDelete: Cascade: um endereço sem dono não tem razão de existir.
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  clinica Clinica? @relation(fields: [clinicaId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([clinicaId])
  @@index([cep])
  @@map("enderecos")
}

// ============================================================
// 3. PERFIS DE NEGÓCIO
// ============================================================

model Clinica {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome      String       @db.VarChar(255)
  cnpj      String?      @unique @db.VarChar(20)
  porte     PorteClinica @default(pequeno)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?    @map("deleted_at") @db.Timestamptz(6)

  // telefone/endereco removidos daqui — ver Telefone/Endereco (refatoração 2)
  telefones     Telefone[]
  enderecos     Endereco[]
  profissionais Profissional[]

  @@map("clinicas")
}

model Profissional {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId            String          @unique @map("usuario_id") @db.Uuid
  clinicaId            String?         @map("clinica_id") @db.Uuid
  registroProfissional String          @map("registro_profissional") @db.VarChar(50)
  especialidade        String?         @db.VarChar(255)
  bio                  String?         @db.Text
  pontosIncentivo      Int             @default(0) @map("pontos_incentivo")
  statusAprovacao      StatusAprovacao @default(pendente) @map("status_aprovacao")
  aprovadoPor          String?         @map("aprovado_por") @db.Uuid
  aprovadoEm           DateTime?       @map("aprovado_em") @db.Timestamptz(6)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  usuario            Usuario           @relation("UsuarioProfissional", fields: [usuarioId], references: [id])
  clinica            Clinica?          @relation(fields: [clinicaId], references: [id])
  aprovadoPorUsuario Usuario?          @relation("ProfissionalAprovadoPor", fields: [aprovadoPor], references: [id])
  pacientes          Paciente[]
  receitasAprovadas  Receita[]         @relation("ReceitaAprovador")
  pontosTransacoes   PontosTransacao[]
  planosAlimentares  PlanoAlimentar[]
  anamneses          Anamnese[]
  assinaturas        Assinatura[]

  @@index([clinicaId])
  @@index([statusAprovacao])
  @@map("profissionais")
}

model Paciente {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId      String   @unique @map("usuario_id") @db.Uuid
  profissionalId String?  @map("profissional_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  usuario              Usuario                 @relation("UsuarioPaciente", fields: [usuarioId], references: [id])
  profissional         Profissional?           @relation(fields: [profissionalId], references: [id])
  dadosSocioeconomicos DadoSocioeconomico?
  restricoes           PacienteRestricao[]
  planosAlimentares    PlanoAlimentar[]
  checklistRefeicoes   ChecklistRefeicao[]
  diarioSintomas       DiarioSintoma[]
  anamneses            Anamnese[]
  logsAcessoRecebidos  LogAcessoDadoSensivel[] @relation("LogAcessoPaciente")
  receitasAdaptadas    ReceitaAdaptacao[]

  @@index([profissionalId])
  @@map("pacientes")
}

model DadoSocioeconomico {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pacienteId            String   @unique @map("paciente_id") @db.Uuid
  rendaFamiliarMensal   Decimal? @map("renda_familiar_mensal") @db.Decimal(10, 2)
  numIntegrantesFamilia Int?     @map("num_integrantes_familia")
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  paciente Paciente @relation(fields: [pacienteId], references: [id])

  @@map("dados_socioeconomicos")
}

// ============================================================
// 4. AUTENTICAÇÃO E SESSÃO (agora ligadas a Conta, não a Usuario)
