// ============================================================
// 11. NOTIFICAÇÕES
//
// Refatoração 4 (Exclusive Arc): a versão anterior usava
// referenciaId + referenciaTipo (String livre) para apontar pra
// qualquer tabela, sem FK de verdade — o banco não impedia um
// referenciaId órfão. Trocamos por FKs opcionais reais, uma por tipo
// de entidade que pode gerar notificação. O Prisma não expressa "XOR"
// (exatamente uma preenchida) nativamente, então isso precisa de uma
// CHECK constraint adicionada via SQL raw na migration:
//
//   ALTER TABLE notificacoes ADD CONSTRAINT chk_notificacao_exclusive_arc
//     CHECK (
//       num_nonnulls(receita_id, assinatura_id, plano_alimentar_item_id,
//                     indicacao_id, anamnese_id) = 1
//     );
//
// Cobertura por tipoNotificacao.codigo:
//   aprovacao_receita / rejeicao_receita  -> receitaId
//   assinatura_vencendo / pagamento_falhou -> assinaturaId
//   checklist_pendente / comentario_novo   -> planoAlimentarItemId
//   indicacao_convertida                   -> indicacaoId
//   anamnese_pendente                      -> anamneseId
//
// v5: as notificações da venda de receitas cabem no arco atual, sem
// coluna nova, porque sempre há uma Receita envolvida:
//   receita_vendida (para o vendedor)      -> receitaId (a original)
//   compra_liberada (para o comprador)     -> receitaId (a cópia)
//   reembolso_resolvido (para o comprador) -> receitaId (a original)
// A vitrine precisou de uma coluna nova, produtoId. A CHECK acima passa
// a contar 6 colunas (ver o SQL no cabeçalho do arquivo):
//   produto_removido (para o vendedor)     -> produtoId
// ============================================================

model Notificacao {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId         String @map("usuario_id") @db.Uuid
  tipoNotificacaoId String @map("tipo_notificacao_id") @db.Uuid

  // Exclusive arc — ver nota da CHECK constraint acima
  receitaId            String? @map("receita_id") @db.Uuid
  assinaturaId         String? @map("assinatura_id") @db.Uuid
  planoAlimentarItemId String? @map("plano_alimentar_item_id") @db.Uuid
  indicacaoId          String? @map("indicacao_id") @db.Uuid
  anamneseId           String? @map("anamnese_id") @db.Uuid
  produtoId            String? @map("produto_id") @db.Uuid

  titulo    String    @db.VarChar(255)
  mensagem  String?   @db.Text
  lida      Boolean   @default(false)
  lidaEm    DateTime? @map("lida_em") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  usuario         Usuario         @relation(fields: [usuarioId], references: [id])
  tipoNotificacao TipoNotificacao @relation(fields: [tipoNotificacaoId], references: [id])

  // onDelete: Cascade nas 6 abaixo (Exclusive Arc): se a entidade de
  // origem for excluída de verdade, a notificação perdeu sua única
  // razão de existir e deve ser removida junto — nunca deve sobrar
  // uma linha com as 6 colunas nulas, isso violaria a CHECK
  // constraint chk_notificacao_exclusive_arc (ver migration).
  receita            Receita?            @relation(fields: [receitaId], references: [id], onDelete: Cascade)
  assinatura         Assinatura?         @relation(fields: [assinaturaId], references: [id], onDelete: Cascade)
  planoAlimentarItem PlanoAlimentarItem? @relation(fields: [planoAlimentarItemId], references: [id], onDelete: Cascade)
  indicacao          Indicacao?          @relation(fields: [indicacaoId], references: [id], onDelete: Cascade)
  anamnese           Anamnese?           @relation(fields: [anamneseId], references: [id], onDelete: Cascade)
  produto            Produto?            @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([usuarioId, lida])
  @@map("notificacoes")
}

