// ============================================================
// 13. VENDA DE RECEITAS (v5)
//
// Regras completas na seção "Marketplace" da documentação da API.
// Resumo do que a modelagem assume:
// - Vende quem é autor de uma Receita `aprovada` e tem ContaRecebedor
//   `ativo`. Compra qualquer usuário logado.
// - O pagamento passa pelo Mercado Pago com split 1:1: o valor cai na
//   conta Mercado Pago do vendedor e a comissão (`marketplace_fee`) na
//   da plataforma. A plataforma nunca guarda saldo de terceiros, por
//   isso não existe tabela de carteira/saque aqui.
// - A compra só entrega conteúdo depois do webhook de pagamento: é
//   nesse momento que a Receita-cópia é criada.
// ============================================================

// Conexão do vendedor com o Mercado Pago (OAuth). Dados bancários e
// documentos ficam só lá; aqui ficam o ID da conta e os tokens que a
// API usa para criar a cobrança em nome do vendedor.
//
// Os tokens dão acesso à conta do vendedor: são gravados cifrados
// (chave fora do banco) e nunca saem em resposta de rota. O access
// token do Mercado Pago vale 180 dias; um job o renova pelo refresh
// token antes de tokenExpiraEm. Se a renovação falhar, o status vira
// `desconectado` e as ofertas do vendedor saem do ar.
model ContaRecebedor {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId           String          @unique @map("usuario_id") @db.Uuid
  gateway             String          @default("mercado_pago") @db.VarChar(50)
  // No Mercado Pago, o user_id da conta do vendedor.
  gatewayRecebedorId  String          @map("gateway_recebedor_id") @db.VarChar(255)
  accessTokenCifrado  String          @map("access_token_cifrado") @db.Text
  refreshTokenCifrado String          @map("refresh_token_cifrado") @db.Text
  tokenExpiraEm       DateTime        @map("token_expira_em") @db.Timestamptz(6)
  status              StatusRecebedor @default(ativo)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([gateway, gatewayRecebedorId])
  @@map("contas_recebedor")
}

// A oferta de venda de uma Receita. 1:1 com Receita (receitaId @unique).
// "Está à venda" não é uma coluna: é ativa = true E receita aprovada e
// não excluída E vendedor com ContaRecebedor ativo. Assim, editar a
// receita (que a devolve para `pendente`) tira a oferta do ar sozinha,
// e a nova aprovação a devolve, sem job de sincronização.
//
// ativa = false é "pausada": continua com o conteúdo fechado, só não
// pode ser comprada. A oferta nunca é apagada: receita paga não volta a
// ser gratuita, nem gratuita vira paga (ver documentação).
model ReceitaOferta {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receitaId String   @unique @map("receita_id") @db.Uuid
  preco     Decimal  @db.Decimal(10, 2)
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  receita     Receita                    @relation(fields: [receitaId], references: [id])
  publicoAlvo ReceitaOfertaPublicoAlvo[]
  compras     ReceitaCompra[]

  @@index([ativa])
  @@map("receita_ofertas")
}

// Público-alvo da oferta: para quais restrições o vendedor oferece a
// receita. Só entra aqui restrição para a qual a receita passou na
// mesma checagem de segurança do filtro `seguraPara`. A linha registra
// a intenção do vendedor; o filtro da listagem continua conferindo a
// segurança na hora, porque a curadoria de ingredientes muda depois.
model ReceitaOfertaPublicoAlvo {
  ofertaId    String   @map("oferta_id") @db.Uuid
  restricaoId String   @map("restricao_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  oferta    ReceitaOferta      @relation(fields: [ofertaId], references: [id], onDelete: Cascade)
  restricao RestricaoAlimentar @relation(fields: [restricaoId], references: [id], onDelete: Restrict)

  @@id([ofertaId, restricaoId])
  @@index([restricaoId])
  @@map("receita_oferta_publico_alvo")
}

// Uma compra. precoPago e taxaPlataforma são congelados na criação:
// mudar o preço da oferta ou a comissão depois não reescreve o passado.
//
// receitaCopiaId fica null até o pagamento ser confirmado. A cópia é
// uma Receita nova, com os ingredientes e mídias da original naquele
// momento (versaoComprada), status `aprovada` e o mesmo criadoPor do
// vendedor (a autoria não muda). ReceitaVersao não guarda ingredientes,
// então apontar para "a versão comprada" da original não bastaria.
//
// Unicidade "uma compra viva por comprador e oferta" é o índice parcial
// uq_receita_compra_viva do cabeçalho — um @@unique comum impediria
// comprar de novo depois de um cancelamento.
//
// Reembolso: o prazo de 7 dias conta de pagaEm. primeiroAcessoEm é
// gravado na primeira vez que o comprador abre o conteúdo da cópia
// (detalhe ou ingredientes; a listagem de compradas não conta). Nulo =
// estorno automático; preenchido = análise do admin. Um pedido por
// compra: reembolsoSolicitadoEm preenchido bloqueia um segundo.
model ReceitaCompra {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ofertaId              String              @map("oferta_id") @db.Uuid
  compradorId           String              @map("comprador_id") @db.Uuid
  precoPago             Decimal             @map("preco_pago") @db.Decimal(10, 2)
  taxaPlataforma        Decimal             @map("taxa_plataforma") @db.Decimal(10, 2)
  versaoComprada        Int                 @map("versao_comprada")
  status                StatusCompraReceita @default(pendente)
  // Preferência do Checkout Pro e o link de pagamento dela. Uma compra
  // pendente devolve o mesmo link em vez de criar outra preferência.
  gatewayPreferenciaId  String?             @unique @map("gateway_preferencia_id") @db.VarChar(255)
  checkoutUrl           String?             @map("checkout_url") @db.VarChar(500)
  receitaCopiaId        String?             @unique @map("receita_copia_id") @db.Uuid
  pagaEm                DateTime?           @map("paga_em") @db.Timestamptz(6)
  primeiroAcessoEm      DateTime?           @map("primeiro_acesso_em") @db.Timestamptz(6)
  reembolsoSolicitadoEm DateTime?           @map("reembolso_solicitado_em") @db.Timestamptz(6)
  reembolsoMotivo       String?             @map("reembolso_motivo") @db.Text
  reembolsoResolvidoEm  DateTime?           @map("reembolso_resolvido_em") @db.Timestamptz(6)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  oferta       ReceitaOferta @relation(fields: [ofertaId], references: [id])
  comprador    Usuario       @relation(fields: [compradorId], references: [id])
  receitaCopia Receita?      @relation("CompraCopia", fields: [receitaCopiaId], references: [id])
  pagamentos   Pagamento[]

  @@index([compradorId, status])
  @@index([ofertaId])
  @@map("receita_compras")
}

// ============================================================
// 14. VITRINE DE PRODUTOS (v5)
//
// Classificados: o vendedor publica, o interessado vê o contato e os
// dois se resolvem fora da plataforma. Não há pagamento, carrinho,
// estoque nem frete — por isso nada aqui se liga a Pagamento.
//
// Diferença importante para a venda de receitas: o público-alvo de um
// produto é DECLARADO pelo vendedor e não tem como ser verificado pela
// API (o produto é físico, não é uma lista de Ingrediente). Serve de
// filtro de busca e nunca deve ser apresentado como "seguro para" uma
// restrição.
//
// Quem anuncia: usuário `comum` ou `paciente`. O `profissional` não
// anuncia produto (o código de ética do CFN, arts. 60 e 63, veda ao
// nutricionista divulgar marcas de alimentos, suplementos e
// utensílios). A regra é da aplicação: o banco não a impõe.
// ============================================================

model Produto {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendedorId        String        @map("vendedor_id") @db.Uuid
  categoriaId       String        @map("categoria_id") @db.Uuid
  titulo            String        @db.VarChar(255)
  descricao         String?       @db.Text
  // null = "a combinar".
  preco             Decimal?      @db.Decimal(10, 2)
  // Só cidade e UF, copiados para o produto. De propósito não é FK para
  // Endereco: a vitrine não deve expor o endereço completo do vendedor.
  cidade            String?       @db.VarChar(100)
  estado            String?       @db.VarChar(2)
  // Número (do próprio vendedor) exibido como contato. SetNull: se o
  // vendedor apagar o telefone, o produto fica sem contato e a aplicação
  // o tira da vitrine até outro número ser escolhido.
  telefoneContatoId String?       @map("telefone_contato_id") @db.Uuid
  status            StatusProduto @default(ativo)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(6)

  vendedor        Usuario              @relation(fields: [vendedorId], references: [id])
  categoria       CategoriaProduto     @relation(fields: [categoriaId], references: [id])
  telefoneContato Telefone?            @relation(fields: [telefoneContatoId], references: [id], onDelete: SetNull)
  midias          ProdutoMidia[]
  publicoAlvo     ProdutoPublicoAlvo[]
  denuncias       ProdutoDenuncia[]
  notificacoes    Notificacao[]

  @@index([status, categoriaId])
  @@index([estado, cidade])
  @@index([vendedorId])
  @@map("produtos")
}

model ProdutoMidia {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  produtoId String   @map("produto_id") @db.Uuid
  url       String   @db.VarChar(500)
  ordem     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([produtoId])
  @@map("produto_midias")
}

model ProdutoPublicoAlvo {
  produtoId   String   @map("produto_id") @db.Uuid
  restricaoId String   @map("restricao_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  produto   Produto            @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  restricao RestricaoAlimentar @relation(fields: [restricaoId], references: [id], onDelete: Restrict)

  @@id([produtoId, restricaoId])
  @@index([restricaoId])
  @@map("produto_publico_alvo")
}

// Denúncia de um produto por um usuário. Uma por usuário e produto.
// Sem onDelete: Cascade de propósito: produto sai do ar por status ou
// deletedAt, e o histórico de moderação precisa continuar existindo.
model ProdutoDenuncia {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  produtoId     String         @map("produto_id") @db.Uuid
  denuncianteId String         @map("denunciante_id") @db.Uuid
  motivo        String         @db.Text
  status        StatusDenuncia @default(aberta)
  resolvidoPor  String?        @map("resolvido_por") @db.Uuid
  resolvidoEm   DateTime?      @map("resolvido_em") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  produto             Produto  @relation(fields: [produtoId], references: [id])
  denunciante         Usuario  @relation("DenunciaDenunciante", fields: [denuncianteId], references: [id])
  resolvidoPorUsuario Usuario? @relation("DenunciaResolvidaPor", fields: [resolvidoPor], references: [id])

  @@unique([produtoId, denuncianteId])
  @@index([status])
  @@map("produto_denuncias")
}
