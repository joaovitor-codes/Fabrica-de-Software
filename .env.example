NODE_ENV=development
PORT=3000
# Database
REDIS_URL=""
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DATABASE_URL="postgresql://user:senha@localhost:5454/nutrify?schema=public"
JWT_SECRET="troque-por-uma-string-aleatoria-de-pelo-menos-32-caracteres"
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Email verification
EMAIL_VERIFICATION_CODE_EXPIRES_MINUTES=15
EMAIL_VERIFICATION_MAX_RESEND_ATTEMPTS=3
EMAIL_VERIFICATION_RESEND_WINDOW_MINUTES=15
SITE_URL="dominio.example.com"
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=true/false
SMTP_USER=youremail@gmail.com
SMTP_PASS=sua-senha-de-aplicativo-do-gmail  
SMTP_FROM="Nutrify <nutrify@gmail.com>"

# IA
OPENAI_API_KEY="sua-chave-de-api-do-openai"

# Mercado Pago (veja "Integração com o Mercado Pago" no README)
# Credenciais de produção da aplicação no Painel do Desenvolvedor. Nos testes,
# use a aplicação criada com a conta de teste Integrador.
MP_CLIENT_ID=1234567890123456
MP_CLIENT_SECRET=seu-client-secret
# Tem que ser idêntica à "URL de redirecionamento" cadastrada no painel e usar HTTPS
# (localmente, com um túnel como o ngrok).
MP_REDIRECT_URI=https://seu-dominio.ngrok-free.dev/api/recebedor/callback
MP_WEBHOOK_SECRET=exemplo_segredo_webhook_123456
MP_ACCESS_TOKEN=APP_USR-...
MP_PUBLIC_KEY=APP_USR-...

# Segurança do recebedor: cifra os tokens OAuth dos vendedores (mínimo 32 caracteres)
RECEBEDOR_TOKEN_KEY=chave_ficticia_trocar_em_producao_123456789

# Endereços usados na preferência do Checkout Pro: a API recebe o webhook em
# API_URL_PUBLICA/api/mercado-pago/webhook (HTTPS; localmente, o mesmo túnel do
# callback) e o comprador volta para FRONT_URL/compra/<id> depois de pagar.
# API_URL_PUBLICA é só o domínio, sem barra nem caminho: com um endereço que o
# Mercado Pago não alcança, o checkout recusa o pagamento sem dizer o motivo.
# Sem front, FRONT_URL pode ser qualquer endereço HTTPS.
API_URL_PUBLICA=https://seu-dominio.ngrok-free.dev
FRONT_URL=https://example.com

# Marketplace
MARKETPLACE_TAXA_PERCENTUAL=15
MARKETPLACE_PRECO_MINIMO=10
MARKETPLACE_REEMBOLSO_DIAS=7
MARKETPLACE_TERMOS_VERSAO=1.0
